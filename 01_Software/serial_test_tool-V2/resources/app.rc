        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AlanStewart\0"
            VALUE "FileDescription", "Serial Link Tester\0"
            VALUE "FileVersion", "0.2.6.0\0"
            VALUE "InternalName", "serial_test_tool\0"
            VALUE "OriginalFilename", "serial_test_tool.exe\0"
            VALUE "ProductName", "Serial Link Tester\0"
            VALUE "ProductVersion", "0.2.6.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
