    {
      "id": "NEW_DIG_SET_BRIGHTNESS_CH1",
      "product_ids": ["atlas-demo-controller"],
      "protocol": "new",
      "category": "数字",
      "title": "设置通道亮度",
      "description": "设置指定通道的亮度。亮度范围受控制器亮度等级影响，最终上限需以对应设备能力为准。",
      "aliases": ["调亮", "调暗", "修改灯光明暗"],
      "keywords": ["灯", "输出", "强度", "255", "CA 01"],
      "frame_format": "hex",
      "parameters": [
        {"id": "channel", "label": "通道", "type": "integer", "encoding": "u8", "min": 1, "max": 8, "default": 1, "unit": "路"},
        {"id": "value", "label": "亮度", "type": "integer", "encoding": "u16be", "min": 0, "max": 999, "default": 255, "unit": ""}
      ],
      "segments": [
        {"kind": "fixed", "encoding": "hex", "value": "CA 01"},
        {"kind": "parameter", "parameter": "channel", "encoding": "u8"},
        {"kind": "parameter", "parameter": "value", "encoding": "u16be"},
        {"kind": "computed", "algorithm": "xor_bcc"}
      ]
    },
