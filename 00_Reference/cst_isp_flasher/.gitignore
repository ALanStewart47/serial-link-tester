# ================= 构建产物 =================
# CMake / Qt Creator 构建目录（含 build、build-release、build-mcu-net 等）
build/
build-*/
Build/

# CMake 中间产物（防止源码内构建误提交）
CMakeCache.txt
CMakeCache.txt.prev
CMakeFiles/
CMakeScripts/
cmake_install.cmake
cmake_uninstall.cmake
install_manifest.txt
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
compile_commands.json
Makefile
build.ninja
.ninja_deps
.ninja_log
_deps/
.cmake/
.qt/
.qtc/
*_autogen/
qtcsettings.cmake

# 编译/链接中间产物
*.o
*.obj
*.a
*.lib
*.exp
*.lo
*.la
*.gch
*.pch
*.pdb
*.ilk
*.idb
*.map
*.d

# 可执行文件
*.exe
*.out

# ================= Qt 生成代码 =================
# moc / uic / rcc 产物（正常在构建目录里，此处兜底源码内构建）
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc

# ================= IDE / 编辑器 =================
# Qt Creator
.qtcreator/
*.user
*.user.*
*.autosave
.qtc_clangd/
CMakeUserPresets.json

# 其他编辑器
.vscode/
.idea/
.cache/
.clangd/

# ================= 发布 / 打包产物 =================
# windeployqt 输出目录与打包脚本产出的压缩文件
release/
Release/
dist/
*.zip
*.7z

# ================= 系统文件 =================
.DS_Store
Thumbs.db
desktop.ini
